<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema" oor:name="Sidebar" oor:package="org.openoffice.Office.UI">
  <node oor:name="Content">
    <node oor:name="DeckList">
      <node oor:name="SidecarDeck" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Sidecar</value></prop>
        <prop oor:name="Id" oor:type="xs:string"><value>SidecarDeck</value></prop>
        <prop oor:name="IconURL" oor:type="xs:string"><value>vnd.sun.star.extension://com.atlasomnia.sidecar.libreoffice/icons/sidecar-deck.png</value></prop>
        <prop oor:name="ContextList"><value oor:separator=";">any, any, visible ;</value></prop>
        <prop oor:name="OrderIndex" oor:type="xs:int"><value>900</value></prop>
      </node>
    </node>
    <node oor:name="PanelList">
      <node oor:name="SidecarChatPanel" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Chat</value></prop>
        <prop oor:name="TitleBarIsOptional" oor:type="xs:boolean"><value>true</value></prop>
        <prop oor:name="Id" oor:type="xs:string"><value>SidecarChatPanel</value></prop>
        <prop oor:name="DeckId" oor:type="xs:string"><value>SidecarDeck</value></prop>
        <prop oor:name="ContextList"><value oor:separator=";">any, any, visible ;</value></prop>
        <prop oor:name="ImplementationURL" oor:type="xs:string"><value>private:resource/toolpanel/SidecarSidebar/SidecarChatPanel</value></prop>
        <prop oor:name="OrderIndex" oor:type="xs:int"><value>100</value></prop>
      </node>
    </node>
  </node>
</oor:component-data>
