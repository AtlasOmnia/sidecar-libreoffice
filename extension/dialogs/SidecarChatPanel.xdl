<!DOCTYPE dlg:window PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "dialog.dtd">
<dlg:window xmlns:dlg="http://openoffice.org/2000/dialog" xmlns:script="http://openoffice.org/2000/script" dlg:id="SidecarChatPanel" dlg:left="0" dlg:top="0" dlg:width="160" dlg:height="90" dlg:closeable="true" dlg:moveable="true" dlg:withtitlebar="false">
  <!-- The launcher panel. Native colours, so it follows LibreOffice's own appearance.
       Python lays the controls out in pixels (hermes_sidebar.plan_layout). -->
  <dlg:styles>
    <dlg:style dlg:style-id="title" dlg:font-height="12" dlg:font-weight="150"/>
    <dlg:style dlg:style-id="caption" dlg:font-height="10"/>
  </dlg:styles>
  <dlg:bulletinboard>
    <dlg:img dlg:id="BrandMark" dlg:tab-index="2" dlg:left="6" dlg:top="5" dlg:width="13" dlg:height="13" dlg:src="vnd.sun.star.extension://com.atlasomnia.sidecar.libreoffice/icons/sidecar-deck.png" dlg:scale-image="true"/>
    <dlg:text dlg:id="Title" dlg:style-id="title" dlg:tab-index="3" dlg:left="23" dlg:top="4" dlg:width="131" dlg:height="10" dlg:value="Sidecar for LibreOffice"/>
    <dlg:text dlg:id="Subtitle" dlg:style-id="caption" dlg:tab-index="4" dlg:left="23" dlg:top="14" dlg:width="131" dlg:height="8" dlg:value="by Atlas Omnia"/>
    <dlg:text dlg:id="Status" dlg:style-id="caption" dlg:tab-index="1" dlg:left="6" dlg:top="24" dlg:width="148" dlg:height="32" dlg:multiline="true" dlg:value="Checking Hermes…"/>
    <dlg:button dlg:id="OpenSidecar" dlg:tab-index="0" dlg:left="6" dlg:top="60" dlg:width="110" dlg:height="16" dlg:default="true" dlg:value="Open Sidecar"/>
  </dlg:bulletinboard>
</dlg:window>
